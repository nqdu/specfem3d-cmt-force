/* setup/config.h.cmake.in -- CMake version of config.h.in */
/* Generated for use with CMake's configure_file() and #cmakedefine */

/* Define to dummy 'main' function (if any) required to link to the Fortran
   libraries. */
/* #undef FC_DUMMY_MAIN */

/* Define if F77 and FC dummy 'main' functions are identical. */
/* #undef FC_DUMMY_MAIN_EQ_F77 */

/* Fortran name-mangling macros.
 * FC_mangling.h is generated by CMake's FortranCInterface module and provides
 * FC_GLOBAL(name,NAME) and FC_GLOBAL_(name,NAME).  We alias them to the
 * FC_FUNC / FC_FUNC_ names that SPECFEM3D C sources expect. */
#include "FC_mangling.h"
#ifndef FC_FUNC
#  define FC_FUNC(name,NAME)  FC_GLOBAL(name,NAME)
#endif
#ifndef FC_FUNC_
#  define FC_FUNC_(name,NAME) FC_GLOBAL_(name,NAME)
#endif

/* Define if emmintrin.h */
#cmakedefine HAVE_EMMINTRIN 1

/* Define if err.h */
#cmakedefine HAVE_ERR 1

/* Define to 1 if you have the <inttypes.h> header file. */
#cmakedefine HAVE_INTTYPES_H 1

/* Define to 1 if you have the 'vtkCommon' library (-lvtkCommon). */
#cmakedefine HAVE_LIBVTKCOMMON 1

/* Define to 1 if you have the 'vtkDICOMParser' library (-lvtkDICOMParser). */
#cmakedefine HAVE_LIBVTKDICOMPARSER 1

/* Define to 1 if you have the 'vtkexpat' library (-lvtkexpat). */
#cmakedefine HAVE_LIBVTKEXPAT 1

/* Define to 1 if you have the 'vtkFiltering' library (-lvtkFiltering). */
#cmakedefine HAVE_LIBVTKFILTERING 1

/* Define to 1 if you have the 'vtkGenericFiltering' library
   (-lvtkGenericFiltering). */
#cmakedefine HAVE_LIBVTKGENERICFILTERING 1

/* Define to 1 if you have the 'vtkGraphics' library (-lvtkGraphics). */
#cmakedefine HAVE_LIBVTKGRAPHICS 1

/* Define to 1 if you have the 'vtkRendering' library (-lvtkRendering). */
#cmakedefine HAVE_LIBVTKRENDERING 1

/* Define to 1 if you have the 'vtksys' library (-lvtksys). */
#cmakedefine HAVE_LIBVTKSYS 1

/* Define to 1 if you have the 'vtkzlib' library (-lvtkzlib). */
#cmakedefine HAVE_LIBVTKZLIB 1

/* Define if you have POSIX threads libraries and header files. */
#cmakedefine HAVE_PTHREAD 1

/* defined if Scotch is installed */
#cmakedefine HAVE_SCOTCH 1

/* Define to 1 if you have the <stdint.h> header file. */
#cmakedefine HAVE_STDINT_H 1

/* Define to 1 if you have the <stdio.h> header file. */
#cmakedefine HAVE_STDIO_H 1

/* Define to 1 if you have the <stdlib.h> header file. */
#cmakedefine HAVE_STDLIB_H 1

/* Define to 1 if you have the <strings.h> header file. */
#cmakedefine HAVE_STRINGS_H 1

/* Define to 1 if you have the <string.h> header file. */
#cmakedefine HAVE_STRING_H 1

/* Define to 1 if you have the <sys/stat.h> header file. */
#cmakedefine HAVE_SYS_STAT_H 1

/* Define to 1 if you have the <sys/types.h> header file. */
#cmakedefine HAVE_SYS_TYPES_H 1

/* Define to 1 if you have the <unistd.h> header file. */
#cmakedefine HAVE_UNISTD_H 1

/* define if the VTK library is available */
#cmakedefine HAVE_VTK 1

/* Define if xmmintrin.h */
#cmakedefine HAVE_XMMINTRIN 1

/* Define to the address where bug reports for this package should be sent. */
#define PACKAGE_BUGREPORT "see the wiki"

/* Define to the full name of this package. */
#define PACKAGE_NAME "SPECFEM3D Cartesian"

/* Define to the full name and version of this package. */
#define PACKAGE_STRING "SPECFEM3D Cartesian @PROJECT_VERSION@"

/* Define to the one symbol short name of this package. */
#define PACKAGE_TARNAME "Specfem3D"

/* Define to the home page for this package. */
#define PACKAGE_URL ""

/* Define to the version of this package. */
#define PACKAGE_VERSION "@PROJECT_VERSION@"

/* Define to necessary symbol if this constant uses a non-standard name on
   your system. */
/* #undef PTHREAD_CREATE_JOINABLE */

/* Define GIT branch for package source. */
#cmakedefine SPECFEM3D_GIT_BRANCH "@SPECFEM3D_GIT_BRANCH@"

/* Define date of GIT commit for package source. */
#cmakedefine SPECFEM3D_GIT_DATE "@SPECFEM3D_GIT_DATE@"

/* Define GIT hash for package source. */
#cmakedefine SPECFEM3D_GIT_HASH "@SPECFEM3D_GIT_HASH@"

/* Define git revision commit for package source. */
#cmakedefine SPECFEM3D_GIT_REVISION "@SPECFEM3D_GIT_REVISION@"

/* Set to 0 if source is from GIT, 1 otherwise. */
#define SPECFEM3D_RELEASE_VERSION 0

/* Define SPECFEM3D version */
#define SPECFEM3D_VERSION "@PROJECT_VERSION@"

/* Define to 1 if all of the C89 standard headers exist (not just the ones
   required in a freestanding environment). This macro is provided for
   backward compatibility; new code need not use it. */
#cmakedefine STDC_HEADERS 1

/* Define to 1 if 'lex' declares 'yytext' as a 'char *' by default, not a
   'char[]'. */
/* #undef YYTEXT_POINTER */

/* Define to select optimized file i/o for regional simulations */
/* map fails when output files are > 4GB, which is often the case for GPU simulations */
/* #undef USE_MAP_FUNCTION */
